# Pipeline 6 / Qwen3.5-2B NVFP4 benchmark knobs.
#
# The retriever and qwen35-vllm compose files consume these values. Change
# this file, then recreate only the Pipeline 6 retriever/Qwen services.

# vLLM admission and memory budget. Keep utilization at or below 0.20 for
# the current ~10 GiB hard cap on the shared 48 GiB GPU.
OPTION6_MODEL=AxionML/Qwen3.5-2B-NVFP4
OPTION6_VLLM_MODEL_PATH=/models/huggingface/models--AxionML--Qwen3.5-2B-NVFP4/snapshots/6f2ad4febe92be529de499b08f0020f5ff06bf25
OPTION6_VLLM_SERVED_MODEL=AxionML/Qwen3.5-2B-NVFP4
OPTION6_VLLM_QUANTIZATION=modelopt_fp4
OPTION6_VLLM_MAX_MODEL_LEN=32768
OPTION6_VLLM_MAX_NUM_SEQS=8
OPTION6_VLLM_MAX_NUM_BATCHED_TOKENS=4096
OPTION6_VLLM_GPU_MEMORY_UTILIZATION=0.20
OPTION6_VLLM_MAX_CUDAGRAPH_CAPTURE_SIZE=16

# Client fan-out must match the 10 GiB engine admission ceiling above.  Keep
# exactly eight requests in flight; vLLM continuously batches them and the
# Pipeline 6 producer refills a slot as soon as one request completes.
OPTION6_VLM_BATCH_SIZE=8
OPTION6_VLM_MAX_CONCURRENCY=8
OPTION6_VLM_MAX_OUTPUT_TOKENS_TEXT=4096
OPTION6_VLM_MAX_OUTPUT_TOKENS_TABLE=4096
OPTION6_VLM_MAX_OUTPUT_TOKENS_VISUAL=32
# Prompt A/B profile: legacy, strict, char_repair, word_repair, guarded_repair.
OPTION6_PROMPT_PROFILE=word_repair
OPTION6_NATIVE_TABLE_TEXT_ENABLED=false
OPTION6_NATIVE_TABLE_MIN_CHARS=8

# Page Elements and crop planning.
OPTION6_DETECTOR_BATCH_SIZE=128
OPTION6_DETECTOR_MAX_POOL_WORKERS=1
OPTION6_PAGE_ELEMENTS_WORKERS=1
OPTION6_CROP_BATCH_SIZE=128
OPTION6_CROP_MAX_CONCURRENCY=4
OPTION6_CROP_IMAGE_FORMAT=JPEG
OPTION6_CROP_JPEG_QUALITY=95

# PDF split/render/extraction workers. Ray still caps these against available
# CPU resources at runtime.
OPTION6_PDF_SPLIT_BATCH_SIZE=1
OPTION6_PDF_EXTRACT_BATCH_SIZE=16
OPTION6_PDF_EXTRACT_WORKERS=4
OPTION6_PDF_EXTRACT_CPUS=2.0

# Pipeline 6 producer-consumer handoff. Four render actors keep at most
# 4 x 16 = 64 pages in PDFium while each ready 16-page block can move through
# Page Elements and into the persistent 8-request VLM pool immediately.
OPTION6_STREAMING_ENABLED=true
OPTION6_STREAM_BATCH_SIZE=16
OPTION6_STREAM_QUEUE_BLOCKS=2

# Scan policy: one masked full-page OCR request plus table/visual crops.
OPTION6_SCAN_FULL_PAGE=true
OPTION6_SCAN_MASK_LAYOUT=true
OPTION6_VISUAL_VLM=true
