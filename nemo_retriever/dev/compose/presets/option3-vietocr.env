# Option 3: Nemotron OCR v2 semantic baseline plus GPU VietOCR branch.
# Start the sidecar with: docker compose --profile vietocr up vietocr-ocr
RETRIEVER_HTTP_PORT=7780
VIETNAMESE_OCR_URL=http://vietocr-ocr:8000/v1/ocr
VIETOCR_MODEL=vgg_seq2seq
VIETOCR_DEVICE=cuda:0
VIETOCR_ALLOW_CPU=false
VIETOCR_GPU_ID=0
# Allow up to four in-flight OCR requests while keeping 20% free VRAM.
VIETOCR_MAX_CONCURRENCY=4
VIETOCR_MIN_FREE_VRAM_FRACTION=0.20
VIETOCR_QUEUE_TIMEOUT_S=120
# Pipeline 2 hard-VRAM mode owns one cross-process GPU lease. Model-level
# OCR still uses controlled internal concurrency, while document jobs queue.
OPTION2_GPU_SCHEDULER_ENABLED=true
OPTION2_GPU_VRAM_LIMIT_MIB=30720
# The OCR models live in the remote NIM/VietOCR sidecars, so the retriever
# workers are lightweight dispatch/process-isolation slots. Keep two batch
# slots so a long legacy/Option-2 document cannot leave a Pipeline 5 upload
# stuck in pending behind it; the sidecars still own GPU batching and memory.
PIPELINE_REALTIME_WORKERS=1
PIPELINE_BATCH_WORKERS=2
