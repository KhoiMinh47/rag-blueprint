# Original core pipeline: Page Elements, Table Structure, Nemotron OCR v2,
# and multimodal Embedding as separate services.
RETRIEVER_HTTP_PORT=7780
DOCKER_GID=976
PADDLEOCR_VL_URL=http://paddleocr-vl-api:8080/layout-parsing
PADDLEOCR_VL_GPU_ID=0
NIM_PAGE_ELEMENTS_URL=http://nim-page-elements:8000/v1/page-elements
# Pipeline 7 uses Table Structure for table cell/row/column geometry.
NIM_TABLE_STRUCTURE_URL=http://nim-table-structure:8000/v1/table-structure
NIM_OCR_URL=http://nim-ocr:8000/v1/ocr
NIM_EMBED_URL=http://nim-embedding:8000/v1/embeddings
# Option 2 uses the true tensor-batch route. The legacy /v1/detect route
# remains available for other callers.
PPOCRV6_DET_URL=http://ppocrv6-det:8000/v1/detect
PPOCRV6_OPTION2_DET_URL=http://ppocrv6-det:8000/v1/detect-batch
PPOCRV6_DET_BATCH_SIZE=16
PPOCRV6_REC_URL=http://ppocrv6-rec:8000/v1/recognize
PPOCRV6_OFFICIAL_URL=http://ppocrv6-official:8000/v1/ocr
PPOCRV6_OFFICIAL_GPU_ID=0
PPOCR_OFFICIAL_DEVICE=gpu:0
PPOCR_OFFICIAL_LANG=vi
TESSERACT_OCR_URL=http://tesseract:8000/v1/ocr
VINTERN_URL=http://vintern-ocr:8000/v1/chat/completions
VINTERN_GPU_ID=0
VINTERN_VLLM_GPU_MEMORY_UTILIZATION=0.30
VINTERN_VLLM_MAX_NUM_SEQS=2
# Pipeline 7 — Ministral 3B FP8 VLM, server-owned endpoint.
MINISTRAL_VLM_URL=http://ministral-fp8:8000/v1/chat/completions
MINISTRAL_VLM_GPU_ID=0
MINISTRAL_VLM_HOST_PORT=8016

# This host exposes one NVIDIA GPU (index 0). Keep the nims-core services on
# that device instead of the multi-GPU defaults from service-mode.compose.yaml.
NIM_PAGE_ELEMENTS_GPU_ID=0
NIM_TABLE_STRUCTURE_GPU_ID=0
NIM_OCR_GPU_ID=0
NIM_EMBED_GPU_ID=0

# Keep one model engine per service on the single GPU, but allow batched
# concurrent requests so the GPU is not left idle between page crops.
NIM_PAGE_ELEMENTS_SERVER_MODE=throughput
NIM_PAGE_ELEMENTS_SERVER_MAX_WAIT_MS=10
# Hard 20-GiB VRAM mode: 16 keeps both detection NIMs below the cap while
# leaving enough room to keep the two OCR engines warm.
NIM_PAGE_ELEMENTS_MAX_BATCH_SIZE=16
NIM_TABLE_STRUCTURE_SERVER_MODE=throughput
NIM_TABLE_STRUCTURE_SERVER_MAX_WAIT_MS=10
NIM_TABLE_STRUCTURE_MAX_BATCH_SIZE=16
# Option 2 can send one wider document micro-batch; other pipeline clients
# keep their own request batch sizes and are not changed by this server cap.
NIM_OCR_MAX_BATCH_SIZE=16
NEMO_RETRIEVER_OPTION2_NEMOTRON_BATCH_SIZE=16
NEMO_RETRIEVER_OPTION2_PREWARM=true
